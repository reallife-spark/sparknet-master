# The training image for a same-family distillation run.
#
# It starts from the node image (torch + transformers already present on the
# Xavier) and adds PEFT. The runtime allow-list of the services is untouched:
# this image is used only by an operator-triggered run, never by a listener.
FROM sparknet-agx-node:dev
RUN pip install --no-cache-dir 'peft==0.13.2' 'datasets==3.1.0' 'accelerate==0.26.1'
COPY train_lora.py /opt/sparknet/train_lora.py
ENTRYPOINT ["/usr/bin/python3", "/opt/sparknet/train_lora.py"]
