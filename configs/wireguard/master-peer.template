# Master-side peer stanza template.
#
# The Master runs `wg0` with this stanza per authorized node. This file is
# documentation + a template for the Master's own configuration; it is NOT
# installed on peers and contains no secrets.
#
# Prerequisite: the node must hold a signed entry in
# manifests/node-authorizations.json. An unsigned peer is not a peer.

# --- The Master's own [Interface] --------------------------------------------
# The MTU must equal the peer's (contracts/overlay.json `mtu`, rationale there).
# A mismatch here is invisible in configuration review and shows up later only as
# unexplained one-directional throughput loss across the tunnel.
#
#     MTU = 1400
#     Address = 10.100.0.1/24
#     ListenPort = 51820
#     PrivateKey = ${MASTER_PRIVATE_KEY}      # never in this repo; mode 0600
#
# Note the asymmetry that is deliberate: a peer's egress is pinned to the Master
# Anchor only, but the Master has unrestricted egress. A rule that is correct on
# a peer would blackhole the fabric here.

[Peer]
# Identity and overlay address from the signed authorization entry
# (see services/sparknet-authz.py `sign`).
# PublicKey = ${NODE_PUBLIC_KEY}
# AllowedIPs = ${NODE_ADDRESS}

# --- Revocation -------------------------------------------------------------
# Removing this stanza and reloading is how the Master revokes a node:
#
#     wg set wg0 peer ${NODE_PUBLIC_KEY} remove
#     systemctl reload wg-quick@wg0
#
# Revocation is a Master-side action on the Master's own wg0. The peer's
# local wg0.conf is untouched and stays chattr +i, so the peer cannot
# self-reinstate and the Master cannot corrupt the peer's config.
#
# Note the operational consequence, documented in docs/wireguard.md:
# the deployed peer uses iptables SPARKNET-FW chains, not nftables, and does not
# pin all WLAN egress to the Master. A revoked node keeps its LAN surface but
# cannot receive a signed instruction over the overlay, so revocation makes it
# inert for guarded actions: isolation, not a warning.

# --- Connectivity -----------------------------------------------------------
# 10.100.0.1/32 is the Master. A node's AllowedIPs on the Master side must
# cover only its own overlay address, so a node cannot source-spoof a sibling.
#
# For telemetry and instant pushes the Master may additionally listen on
# 10.100.0.1:8090 (instant-push webhooks) and the guard listens on each peer's
# 10.100.0.x:9090 (signed approval payloads). Both are overlay-only.