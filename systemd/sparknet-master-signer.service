# The isolated operational signer — the only process that holds the Master key.
#
# Three decisions in this file are deliberate, and all three are refusals:
#
# 1. `--root` points at the *state* trust root, not at
#    manifests/cluster-trust-root.json. That manifest is a fail-closed template
#    (master_node_id: null, no signatures), and a signer pointed at it refuses to
#    start. On a node that has not won an election, this unit failing IS the
#    correct behaviour: a node is a peer until elected.
#
# 2. `SPARKNET_NODE_ID` and `SPARKNET_STATE_DIR` have no `:-` fallback, unlike
#    SPARKNET_STATE_DIR in the other roles. Empty would pass the `if not
#    args.node_id` check with a confusing error, and a default node id would let
#    the unit start as the wrong node. systemd passes an unset variable through
#    as empty, so the process refuses to start and says why.
#
# 3. There is no `User=`. The key is 0600 and owned by whoever ran `make keygen`;
#    the unit cannot widen that, and a hardcoded user would be a lie on any host
#    where the key was generated by someone else. Isolation here is the
#    filesystem and the socket, not an account name.
[Unit]
Description=Sparknet master isolated signer (operational key, unix socket only)
After=network-online.target
# Signing needs the ledger service to have verified the chain it appends to.
Requires=sparknet-master-ledger.service
After=sparknet-master-ledger.service

[Service]
Type=simple
EnvironmentFile=-%h/.env
ExecStart=/usr/bin/env python3 %h/services/sparknet-signer.py \
    --node-id ${SPARKNET_NODE_ID} \
    --key ${SPARKNET_STATE_DIR}/keys/operational.ed25519 \
    --root ${SPARKNET_STATE_DIR}/trust-root.json \
    --socket ${SPARKNET_STATE_DIR}/signer/signer.sock \
    --ledger %h/blockchain/ledger.json \
    --allow-caller %h/services/sparknet-admin-console.py \
    --allow-caller %h/services/sparknet-distill.py \
    --allow-caller %h/services/sparknet-evidence-capture.py \
    --allow-caller %h/services/sparknet-review-agents.py \
    --allow-caller %h/services/sparknet-scheduler.py \
    --allow-caller %h/services/sparknet-share-ratify.py \
    --allow-caller %h/scripts/sparknet-signer-probe.sh \
    --allow-caller %h/scripts/sparknet-registry-sign-socket.sh \
    --allow-caller %h/scripts/sparknet-registry-publish.sh \
    --allow-caller %h/scripts/sparknet-approval-sign-socket.sh \
    --allow-caller %h/scripts/sparknet-rfi-answer.sh \
    --allow-caller %h/scripts/sparknet-share-ratify-unit.sh
Restart=on-failure
RestartSec=5

# The unit does not become enabled just because the signer exists. Electing this
# node is an act with a key, not an install side effect — `make units` decides.
[Install]
WantedBy=multi-user.target
